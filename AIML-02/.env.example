# Copy to .env before running Docker Compose.
MONGO_URI=mongodb://mongo:27017
MONGO_DATABASE=medscan

# Model checkpoint is created by ml/train.py and mounted into the backend.
MODEL_PATH=/app/app/models/densenet121_nih14.pth
MODEL_THRESHOLD=0.50
SEGMENTATION_MODEL_PATH=/app/app/models/unet3d_msd_lung.pth
MAX_VOLUME_MB=200

# Orthanc local-demo credentials. Change these before exposing the service.
ORTHANC_URL=http://orthanc:8042
ORTHANC_USERNAME=demo
ORTHANC_PASSWORD=demo-change-me

# Local development only. Set explicit origins for a deployed environment.
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=20

# Enables clearly-labelled simulated output so the dashboard/review workflow can be demonstrated
# before downloading data and training. It is NOT AI inference and MUST NOT be represented as such.
DEMO_MODE=true
